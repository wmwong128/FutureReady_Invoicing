{
  "name": "docker_oriented_rest_template",
  "version": "1.0.0",
  "description": "A simple RESTful API.",
  "main": "index.js",
  "scripts": {
    "compile": "tsc",
    "start": "node ./dist/index.js",
    "daily": "node ./dist/index.daily.js",
    "serve": "npm run compile && node ./dist/scripts/serve.js",
    "dev": "nodemon --exec 'npm run compile && npm run start'",
    "dev1": "nodemon --watch src --exec \"tsc && node ./dist/index.js\"",
    "dev-noauth": "NOAUTH=true npm run dev",
    "dev-daily": "npm run compile && npm run daily"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.3",
    "@types/method-override": "^3.0.0",
    "@types/mongoose": "^5.11.96",
    "@types/node": "^24.3.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-oauth2-jwt-bearer": "^1.6.1",
    "method-override": "^3.0.0",
    "mongoose": "^8.17.2",
    "resend": "^6.0.1",
    "stripe": "^18.4.0"
  },
  "containerPort": 8080,
  "hostPort": 8080,
  "nodemonConfig": {
    "ignore": [
      "node_modules",
      "dist"
    ],
    "ext": "*.ts",
    "delay": 1000
  }
}
