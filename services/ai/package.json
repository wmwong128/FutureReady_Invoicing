{
  "name": "docker_oriented_python_server",
  "version": "1.0.0",
  "description": "Docker-oriented python server.",
  "main": "index.js",
  "scripts": {
    "compile": "tsc",
    "pyinstall": "npm run compile && node ./scripts.gen.local/pyinstall.js",
    "pydev": "npm run compile && node ./scripts.gen.local/pydev.js",
    "pydev-noauth": "NOAUTH=1 npm run pydev",
    "pystart": "npm-run-all compile && node ./scripts.gen.local/pystart.js",
    "serve": "npm run compile && node ./scripts.gen.local/serve.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/node": "^24.3.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "dotenv": "^17.2.1"
  },
  "containerPort": 9090,
  "hostPort": 9090
}
